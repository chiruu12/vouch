node_modules/
.next/
.vercel/
.env
.env.*
!.env.example
dist/
out/
*.log
.DS_Store

# Local run artifacts from timing/measurement work.
#
# Raw captures stay out: marketplace output carries plain seller names and this repo is
# public. Scrubbed samples go to engine/samples/ instead.
#
# Supervision state and incidents are IN, for two reasons. They are the evidence the
# write-up and the feed both cite, and `snapshot.ts` reads them, so without them a fresh
# clone cannot build and one test fails. Every file was checked for seller identity
# before being added: state-tradewell.json carries 11 sellerKey hashes and no names,
# state-cpsc.json is 307 public regulator notices and carries none.
# Anything new under runs/ is excluded by default, so a raw capture cannot arrive here
# by accident.
scratch/
runs/*.json
!runs/.gitkeep
!runs/timing.log
!runs/state-arcadia.json
!runs/state-tradewell.json
!runs/state-cpsc.json
!runs/incident-*.json

# local agent fleet config (dev tooling, not part of the submission)
fleet.config.yaml
.marshal/

# Vercel deploy staging dir for the fixture (generated by fixtures/build.mjs)
fixtures/vouch-fixture/
fixtures/tradewell-deploy/
fixtures/shop/dist/
web/tsconfig.tsbuildinfo
